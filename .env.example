# TRACEFORGE environment template
# MVP is designed to run locally without an AI API key or backend secret.
# Never commit .env, access tokens, or production secrets.

# Local application (safe for client exposure; VITE_ values are public in bundles)
VITE_APP_NAME=TRACEFORGE
VITE_APP_ENV=local

# Optional feature flags; keep advanced labs off until implemented and tested.
VITE_ENABLE_TOC_LAB=false
VITE_ENABLE_TINYCPU_LAB=false
VITE_ENABLE_AI_EXPLANATIONS=false

# If a future server-side service is introduced, put server-only variables in that
# service's environment or secret manager. NEVER prefix secrets with VITE_.
# API_BASE_URL=http://localhost:8000
# AI_PROVIDER_API_KEY= # server-side secret only; never commit a real value
# DATABASE_URL=       # server-side secret only
